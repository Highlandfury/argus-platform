# Build outputs
/bin/
coverage/
*.exe

# Generated protobuf code is COMMITTED (gen/go). Regenerate with `make proto`;
# CI verifies no drift (`buf generate` + git diff --exit-code -- gen).

# Local toolchain (installed by scripts/install-tools.ps1, never committed)
/.tools/

# Local dev state and secrets
/.dev/
/data/
.env
.env.*
*.pem
*.key
!docs/**/*.pem.example

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local dev credentials (generated by scripts/dev.ps1)
.env
deployments/compose/.env

# Large load-test dumps: k6 per-point output can exceed the repository host's
# per-file size limit; aggregates/summaries are the committed evidence.
tests/load/results/*_points.json
