# syntax=docker/dockerfile:1
# Build: argus-server (control plane). Multi-stage, static binary, distroless runtime.
# Tag pin: golang:1.27.1 / gcr.io/distroless/static-debian12:nonroot.
# Digest pinning is a tracked task (docs/phase-1/VERSIONS.md).

FROM golang:1.27.1 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
ARG COMMIT=none
ARG BUILD_DATE=unknown
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags "-s -w \
      -X github.com/argus-platform/argus/internal/platform/buildinfo.Version=${VERSION} \
      -X github.com/argus-platform/argus/internal/platform/buildinfo.Commit=${COMMIT} \
      -X github.com/argus-platform/argus/internal/platform/buildinfo.Date=${BUILD_DATE}" \
    -o /out/argus-server ./cmd/argus-server

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/argus-server /argus-server
USER nonroot:nonroot
EXPOSE 8080 8443 8444 9090
ENTRYPOINT ["/argus-server"]
CMD ["serve"]
